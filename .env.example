# Copy to .env.local (and set the same values in Vercel project settings).

# Clerk keys: must be the SAME Clerk application as CGserver
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# CGserver deployment. The browser never calls it directly; /api/proxy does.
BACKEND_URL="https://common-ground-sigma-seven.vercel.app"
# Live chat websocket on CGserver
NEXT_PUBLIC_API_WEBSOCKET="wss://common-ground-sigma-seven.vercel.app/api/ws"

# Supabase Storage for image uploads (bucket: pancit-canton-sns)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_KEY="your-anon-or-publishable-key"
